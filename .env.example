# Copy this file to .env and fill in real values before running.

# ==========================
# Environment
# ==========================
ENV=dev
API_URL=https://api.symulate.weuno.co/dev/api

SUPER_ADMIN_URL=https://superadmin.symulate-dev.weuno.co
CLIENT_ADMIN_URL=https://client-admin.symulate-dev.weuno.co
CANDIDATE_URL=https://symulate-ai-dev.weuno.co

# ==========================
# Credentials
# ==========================
SUPER_ADMIN_EMAIL=superadmin@yopmail.com
SUPER_ADMIN_PASSWORD=

# Only used as a fallback for scenarios/login.js -> clientAdminLogin().
# The main flow (tests/smoke.js) now uses impersonateClientAdmin() instead
# (POST /auth/impersonate-user + /auth/verify-impersonate-user), which
# doesn't need this. See README "Still open".
CLIENT_ADMIN_DEFAULT_PASSWORD=

# STILL OPEN (see README): CSV candidate import doesn't return real
# credentials. Candidates are logged in with this placeholder password
# until Backend confirms the real one / an equivalent flow.
CANDIDATE_DEFAULT_PASSWORD=

# ==========================
# Test behaviour toggles
# ==========================
# full | situation-only
SCENARIO=full

# true | false — with/without Anum API usage
ANUM_API_ENABLED=true

# smoke | load
LOAD_MODE=smoke

# Only used when LOAD_MODE=load
LOAD_VUS=10
LOAD_DURATION=2m
LOAD_RAMP_UP=30s
LOAD_RAMP_DOWN=30s

NUM_CANDIDATES=10
